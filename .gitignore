# ---- Terraform ----
# Local provider plugins and modules (regenerated by `terraform init`)
**/.terraform/*
# State files may contain sensitive data; keep them out of version control
*.tfstate
*.tfstate.*
# Crash log files
crash.log
crash.*.log
# Variable files that may hold secrets (keep examples)
*.tfvars
*.tfvars.json
!example.tfvars
# CLI config / plan output
.terraformrc
terraform.rc
*.tfplan
# NOTE: .terraform.lock.hcl is intentionally NOT ignored - it pins provider
# versions and should be committed.

# ---- Lambda build artifacts (regenerated at apply time) ----
infrastructure/build/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.hypothesis/
